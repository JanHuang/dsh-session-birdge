{
  "name": "dsh-session-bridge",
  "version": "0.5.0",
  "private": true,
  "description": "Durable cross-session chat and groups for DeepSeek Harness.",
  "type": "module",
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.0"
  },
  "main": "src/host/index.js",
  "exports": {
    ".": "./src/host/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "src",
    "client.js",
    "locale/*.json",
    "docs",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "SPEC.md",
    "tsconfig.json",
    "design",
    "README.zh.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "session",
    "bridge",
    "messaging"
  ],
  "license": "MIT"
}
