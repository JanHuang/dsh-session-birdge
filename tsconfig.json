{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "lib": ["ES2023", "DOM"]
  },
  "include": ["src/**/*.js", "tests/**/*.mjs"]
}
